# 이 파일을 복사해 .env를 만들고 값을 채웁니다: cp .env.example .env
# 공개 저장소이므로 실제 토큰, 채널 이름·ID는 .env에만 적고 이 파일에는 넣지 않습니다.

# Slack (Socket Mode)
# Bot User OAuth Token. "xoxb-"로 시작합니다. (OAuth & Permissions 화면)
SLACK_BOT_TOKEN=
# 앱 수준 토큰. "xapp-"로 시작하며 connections:write 권한이 필요합니다. (Basic Information > App-Level Tokens)
SLACK_APP_TOKEN=
# 봇이 이벤트로 공지를 수집할 채널 ID. 봇이 초대된 채널만 쉼표로 구분해 적습니다.
# 공개 채널은 보통 C, 비공개 채널은 C 또는 G로 시작합니다. 예: C0000000001,G0000000002
SLACK_NOTICE_CHANNELS=
# 봇을 초대할 수 없어 운영자 CLI로만 등록·수정·삭제할 채널 ID입니다. 비워 둘 수 있습니다.
SLACK_MANUAL_NOTICE_CHANNELS=
# 각 공지 채널의 배정 대상. all=등록된 광주 학생 전체, 1~4=해당 반.
# 자동·수동 공지 채널을 모두 빠짐없이 지정합니다.
# 예: C0000000001=all,G0000000002=all,C0000000003=3,C0000000099=all
SLACK_NOTICE_TARGETS=

# Database
# 로컬 compose.yaml과 운영 compose.prod.yaml의 PostgreSQL 초기화 값입니다.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# 로컬 예: postgresql+psycopg://<사용자>:<URL 인코딩한 비밀번호>@127.0.0.1:5432/<DB 이름>
# 운영 컨테이너에서는 호스트를 postgres로 지정합니다.
DATABASE_URL=

# AI 분석 (선택)
# nvidia 또는 ollama. 비워 두면 공지 링크만 저장하고 새 체크리스트는 배정하지 않습니다.
AI_PROVIDER=
# AI 응답 대기 시간(초). 비워 두면 45초. 로컬 모델은 첫 요청이 느릴 수 있습니다.
AI_TIMEOUT_SECONDS=

# NVIDIA Build API (AI_PROVIDER=nvidia일 때 필요)
NVIDIA_API_KEY=
# 사용할 모델 ID. build.nvidia.com에서 확인합니다.
NVIDIA_MODEL=
# 비워 두면 https://integrate.api.nvidia.com/v1
NVIDIA_BASE_URL=

# Ollama 로컬 LLM (AI_PROVIDER=ollama일 때 필요)
# 로컬에 받아 둔 모델 이름. `ollama list`로 확인합니다. 예: llama3.2
OLLAMA_MODEL=
# 비워 두면 http://localhost:11434/v1
OLLAMA_BASE_URL=

# Application
# development 또는 production
APP_ENV=development
