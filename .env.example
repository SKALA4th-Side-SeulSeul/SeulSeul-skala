# 이 파일을 복사해 .env를 만들고 값을 채웁니다: cp .env.example .env
# 공개 저장소이므로 실제 토큰, 채널 이름·ID는 .env에만 적고 이 파일에는 넣지 않습니다.

# Slack (Socket Mode)
# Bot User OAuth Token. "xoxb-"로 시작합니다. (OAuth & Permissions 화면)
SLACK_BOT_TOKEN=
# 앱 수준 토큰. "xapp-"로 시작하며 connections:write 권한이 필요합니다. (Basic Information > App-Level Tokens)
SLACK_APP_TOKEN=
# 봇이 공지를 수집할 채널. 쉼표로 구분하며 채널 이름(#포함 가능) 또는 채널 ID(C로 시작)를 적습니다.
# 예: #전체공지,#캠퍼스공지,#반공지_1
SLACK_NOTICE_CHANNELS=

# Database
# DB 선택이 확정되면 형식을 이 주석에 적습니다.
DATABASE_URL=

# AI 요약 (선택)
# nvidia 또는 ollama. 비워 두면 AI 요약 없이 공지 원문만 보여 줍니다.
AI_PROVIDER=
# AI 응답 대기 시간(초). 비워 두면 60초. 로컬 모델은 첫 요청이 느릴 수 있습니다.
AI_TIMEOUT_SECONDS=

# NVIDIA Build API (AI_PROVIDER=nvidia일 때 필요)
NVIDIA_API_KEY=
# 사용할 모델 ID. build.nvidia.com에서 확인합니다.
NVIDIA_MODEL=
# 비워 두면 https://integrate.api.nvidia.com/v1
NVIDIA_BASE_URL=

# Ollama 로컬 LLM (AI_PROVIDER=ollama일 때 필요)
# 로컬에 받아 둔 모델 이름. `ollama list`로 확인합니다. 예: llama3.2
OLLAMA_MODEL=
# 비워 두면 http://localhost:11434/v1
OLLAMA_BASE_URL=

# Application
# development 또는 production
APP_ENV=development
